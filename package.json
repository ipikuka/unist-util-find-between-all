{
  "name": "unist-util-find-between",
  "version": "1.1.6",
  "description": "unist utility to find the nodes between two nodes",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc --build tsconfig.build.json && tsd && type-coverage",
    "format": "npm run prettier && npm run lint",
    "prettier": "prettier --write .",
    "lint": "eslint .",
    "test": "node --test tests/test.spec.js",
    "test-coverage": "c8 --100 --reporter lcov --reporter text npm run test",
    "prepack": "npm run build",
    "prepublishOnly": "npm run format && npm run test-coverage"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipikuka/unist-util-find-between.git"
  },
  "keywords": [
    "unist",
    "unist-util",
    "util",
    "utility",
    "tree",
    "node",
    "find",
    "between"
  ],
  "author": "ipikuka <talatkuyuk@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/ipikuka/unist-util-find-between#readme",
  "bugs": {
    "url": "https://github.com/ipikuka/unist-util-find-between/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.12.2",
    "c8": "^11.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.5.0",
    "mdast-util-from-markdown": "^2.0.3",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsd": "^0.33.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  },
  "dependencies": {
    "@types/unist": "^3.0.3",
    "unist-util-is": "^6.0.1"
  },
  "typeCoverage": {
    "atLeast": 100,
    "detail": true,
    "strict": true
  },
  "tsd": {
    "directory": "tests"
  },
  "sideEffects": false
}
